{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "*.cts"
  ],
  "watchOptions": {
    "excludeDirectories": [
      "../node_modules",
      "../dist",
      "../dist-welcome",
      "../runtime-image",
      "../test"
    ],
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents"
  }
}
