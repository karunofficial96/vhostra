#!/bin/sh
set -eu
source=$0
while [ -L "$source" ]; do
  target=$(readlink "$source")
  case "$target" in /*) source=$target ;; *) source=$(dirname -- "$source")/$target ;; esac
done
contents=$(CDPATH= cd -- "$(dirname -- "$source")/../.." && pwd)
ELECTRON_RUN_AS_NODE=1 exec "$contents/MacOS/Vhostra" "$contents/Resources/app.asar/scripts/vhostra.mjs" "$@"
