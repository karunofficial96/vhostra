{
  "name": "vhostra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight graphical local PHP development environment.",
  "main": "dist-electron/main.js",
  "bin": {
    "vhostra": "scripts/vhostra.mjs"
  },
  "build": {
    "appId": "com.vhostra.app",
    "productName": "Vhostra",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "dist-welcome/**",
      "scripts/vhostra.mjs",
      "scripts/cli-format.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/trayIcon.png",
        "to": "trayIcon.png"
      },
      {
        "from": "build/trayIcon@2x.png",
        "to": "trayIcon@2x.png"
      },
      {
        "from": "runtime-image",
        "to": "runtime-image"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "third-party-licenses",
        "to": "third-party-licenses"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "extraFiles": [
        {
          "from": "packaging/macos/vhostra",
          "to": "Resources/bin/vhostra"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "extraFiles": [
        {
          "from": "packaging/windows/vhostra.cmd",
          "to": "vhostra.cmd"
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "executableName": "VhostraDesktop",
      "extraFiles": [
        {
          "from": "packaging/linux/vhostra",
          "to": "vhostra"
        }
      ]
    }
  },
  "scripts": {
    "predev": "vite build --config vite.welcome.config.ts",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build && vite build --config vite.welcome.config.ts && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:bridge": "node scripts/run-bridge-test.mjs",
    "cli": "node scripts/vhostra.mjs",
    "package:mac": "npm run build && electron-builder --mac dir --publish never",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3"
  }
}
