{
  "name": "vhostra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight graphical local PHP development environment.",
  "main": "dist-electron/main.js",
  "bin": { "vhostra": "scripts/vhostra.mjs" },
  "build": {
    "appId": "com.vhostra.app",
    "productName": "Vhostra",
    "directories": { "buildResources": "build" },
    "extraResources": [{ "from": "build/trayIcon.png", "to": "trayIcon.png" }, { "from": "build/trayIcon@2x.png", "to": "trayIcon@2x.png" }],
    "mac": { "icon": "build/icon.icns" },
    "win": { "icon": "build/icon.ico" },
    "linux": { "icon": "build/icons" }
  },
  "scripts": {
    "predev": "vite build --config vite.welcome.config.ts",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build && vite build --config vite.welcome.config.ts && tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node --test test/store.test.mjs",
    "test:bridge": "node scripts/run-bridge-test.mjs",
    "cli": "node scripts/vhostra.mjs",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.1"
  }
}
